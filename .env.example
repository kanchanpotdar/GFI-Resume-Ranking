# Hugging Face Inference API Token (Used server-side only for BAAI/bge-small-en-v1.5 embeddings)
# Never prefix with NEXT_PUBLIC_ to avoid exposing in client bundles
HUGGINGFACE_API_KEY=hf_your_token_here
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional LLM Key for Ambiguity Resolution in live resume upload extraction
# OPENAI_API_KEY=sk-...

# Application Environment
NODE_ENV=development
